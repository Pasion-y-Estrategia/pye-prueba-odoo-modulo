<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_pye_sale_extras" model="ir.ui.view">
        <field name="name">sale.order.form.pye.sale.extras</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='tax_id']" position="after">
                <field name="extra_discount" optional="show"/>
                <field name="discount_reason_id" optional="show" options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>
</odoo>
