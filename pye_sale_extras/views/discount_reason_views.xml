<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pye_discount_reason_view_list" model="ir.ui.view">
        <field name="name">pye.discount.reason.list</field>
        <field name="model">pye.discount.reason</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="pye_discount_reason_action" model="ir.actions.act_window">
        <field name="name">Motivos de descuento</field>
        <field name="res_model">pye.discount.reason</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="pye_discount_reason_menu"
              name="Motivos de descuento"
              parent="sale.menu_sale_config"
              action="pye_discount_reason_action"
              sequence="40"/>
</odoo>
